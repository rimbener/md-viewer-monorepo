{
  "name": "md-viewer-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @md-viewer/web dev",
    "build:web": "pnpm --filter @md-viewer/web build",
    "dev:tauri": "pnpm --filter @md-viewer/tauri tauri dev",
    "build:tauri": "pnpm --filter @md-viewer/tauri tauri build",
    "build:macos": "pnpm --filter @md-viewer/tauri tauri build --bundles app",
    "install:macos": "pnpm build:macos && ditto 'apps/tauri/src-tauri/target/release/bundle/macos/MD Viewer.app' '/Applications/MD Viewer.app'",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/wicg-file-system-access": "^2023.10.6",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
