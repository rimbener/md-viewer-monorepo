{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Access to the folders and files the viewer shows, and saves to them.",
  "windows": ["main", "document-*"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-open-url",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    }
  ]
}
